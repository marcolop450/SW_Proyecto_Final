# Copiar a .env.production y completar los valores privados.
# APP_DOMAIN contiene solo el nombre, por ejemplo app.ejemplo.com.
APP_DOMAIN=localhost
BIND_ADDRESS=127.0.0.1
RELEASE_TAG=local-production-check

# Copiar las conexiones desde Supabase > Connect > Session pooler.
# Usar la misma base y el mismo esquema en ambas variables.
# Conservar sslmode=require y connect_timeout=20 en las conexiones verificadas.
# Las comillas simples conservan literalmente los signos $ de los valores.
DATABASE_URL=''
DIRECT_URL=''

# Generar un secreto aleatorio de al menos 32 caracteres y guardarlo aquí.
JWT_SECRET=''
JWT_EXPIRES_IN=7d
