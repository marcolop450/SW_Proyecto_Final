// Prisma schema for ErgoCheck AI
// Multi-tenant SST & Proctoring Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Rol {
  SUPER_ADMINISTRADOR
  ADMIN_ORGANIZACION
  SUPERVISOR
  EVALUADOR
  EMPLEADO
  POSTULANTE
}

model Usuario {
  id            String                @id @default(uuid())
  correo        String                @unique @map("correo")
  claveHash     String                @map("clave_hash")
  nombre        String                @map("nombre")
  apellido      String                @map("apellido")
  fotoUrl       String?               @map("foto_url")
  activo        Boolean               @default(true) @map("activo")
  creadoEn      DateTime              @default(now()) @map("creado_en")
  actualizadoEn DateTime              @updatedAt @map("actualizado_en")

  membresias          UsuarioOrganizacion[]
  consentimientos     LegalConsent[]
  sesiones            ErgonomicSession[]
  sesionesSupervision SupervisionSession[]
  registrosAuditoria  AuditLog[]

  @@map("usuarios")
}

model Organizacion {
  id                   String                @id @default(uuid())
  nombre               String                @map("nombre")
  identificacionFiscal String?               @map("identificacion_fiscal")
  slug                 String                @unique
  logoUrl              String?               @map("logo_url")
  activo               Boolean               @default(true) @map("activo")
  creadoEn             DateTime              @default(now()) @map("creado_en")
  actualizadoEn        DateTime              @updatedAt @map("actualizado_en")

  departamentos       Departamento[]
  membresias          UsuarioOrganizacion[]
  suscripciones       Subscription[]
  questionnaires      Questionnaire[]
  sesionesSupervision SupervisionSession[]

  @@map("organizaciones")
}

model Departamento {
  id             String                @id @default(uuid())
  organizacionId String                @map("organizacion_id")
  nombre         String                @map("nombre")
  descripcion    String?               @map("descripcion")
  creadoEn       DateTime              @default(now()) @map("creado_en")
  actualizadoEn  DateTime              @updatedAt @map("actualizado_en")

  organizacion   Organizacion          @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  membresias     UsuarioOrganizacion[]

  @@map("departamentos")
}

model UsuarioOrganizacion {
  id             String        @id @default(uuid())
  usuarioId      String        @map("usuario_id")
  organizacionId String        @map("organizacion_id")
  departamentoId String?       @map("departamento_id")
  rol            Rol           @default(EMPLEADO)
  fechaIngreso   DateTime      @default(now()) @map("fecha_ingreso")

  usuario        Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  organizacion   Organizacion  @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  departamento   Departamento? @relation(fields: [departamentoId], references: [id], onDelete: SetNull)

  @@unique([usuarioId, organizacionId])
  @@map("usuarios_organizaciones")
}

enum ConsentType {
  CAMERA_AND_BIOMETRICS
  TELEMETRY_AND_ACTIVITY
  TERMS_AND_PRIVACY
}

model LegalConsent {
  id         String      @id @default(uuid())
  userId     String      @map("user_id")
  type       ConsentType
  version    String      @default("1.0")
  isAccepted Boolean     @default(false) @map("is_accepted")
  ipAddress  String?     @map("ip_address")
  userAgent  String?     @map("user_agent")
  acceptedAt DateTime?   @map("accepted_at")
  revokedAt  DateTime?   @map("revoked_at")
  createdAt  DateTime    @default(now()) @map("created_at")

  usuario    Usuario     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, isAccepted])
  @@map("legal_consents")
}

enum PlanType {
  SAAS_SEAT_MONTHLY
  PAY_PER_EXAM_PACKAGE
  ENTERPRISE_CUSTOM
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  TRIAL
}

model Subscription {
  id                 String             @id @default(uuid())
  organizationId     String             @map("organization_id")
  planType           PlanType           @map("plan_type")
  status             SubscriptionStatus @default(TRIAL)
  seatsAllocated     Int                @default(5) @map("seats_allocated")
  examsAllocated     Int                @default(0) @map("exams_allocated")
  examsUsed          Int                @default(0) @map("exams_used")
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  organizacion       Organizacion       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices           Invoice[]

  @@map("subscriptions")
}

enum InvoiceStatus {
  PAID
  PENDING
  FAILED
  REFUNDED
}

model Invoice {
  id              String        @id @default(uuid())
  subscriptionId  String        @map("subscription_id")
  invoiceNumber   String        @unique @map("invoice_number")
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("USD")
  status          InvoiceStatus @default(PENDING)
  paymentProvider String?       @map("payment_provider")
  transactionId   String?       @unique @map("transaction_id")
  receiptUrl      String?       @map("receipt_url")
  paidAt          DateTime?     @map("paid_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  subscription    Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

// Hook de estructura previa para Sprint 2
model ErgonomicSession {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  startTime   DateTime  @default(now()) @map("start_time")
  endTime     DateTime? @map("end_time")
  averageRula Float?    @map("average_rula")
  totalAlerts Int       @default(0) @map("total_alerts")

  usuario     Usuario   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ergonomic_sessions")
}

// Sprint 4: Bitácora Inmutable WORM con Encadenamiento Criptográfico SHA-256
model AuditLog {
  id            String    @id @default(uuid())
  userId        String?   @map("user_id")
  action        String
  entity        String
  entityId      String?   @map("entity_id")
  categoria     String    @default("SEGURIDAD")
  ipAddress     String?   @map("ip_address")
  details       Json?
  prevHash      String?   @map("prev_hash")
  hash          String?   @map("hash")
  timestamp     DateTime  @default(now())

  usuario       Usuario?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// Sprint 3: Supervisión de Conducta, Anti-Cheat, Exámenes y Entrevistas
model Questionnaire {
  id              String                @id @default(uuid())
  organizationId  String                @map("organization_id")
  creadorId       String                @map("creador_id")
  titulo          String                @map("titulo")
  descripcion     String?               @map("descripcion")
  tipo            String                @default("EXAMEN") @map("tipo")
  urlExterna      String                @map("url_externa")
  duracionMinutos Int                   @default(60) @map("duracion_minutos")
  codigoAcceso    String                @unique @map("codigo_acceso")
  expiraEn        DateTime              @map("expira_en")
  activo          Boolean               @default(true) @map("activo")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  organizacion     Organizacion         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sesiones         SupervisionSession[]
  preguntasControl ControlQuestion[]

  @@map("questionnaires")
}

model SupervisionSession {
  id                  String                    @id @default(uuid())
  userId              String                    @map("user_id")
  organizationId      String                    @map("organization_id")
  questionnaireId     String?                   @map("questionnaire_id")
  tipo                String                    @default("EXAMEN") @map("tipo")
  estado              String                    @default("EN_PROGRESO") @map("estado")
  inicio              DateTime                  @default(now()) @map("inicio")
  fin                 DateTime?                 @map("fin")
  scoreIntegridad     Float?                    @map("score_integridad")
  totalIncidentes     Int                       @default(0) @map("total_incidentes")
  tiempoActivoSeg     Int                       @default(0) @map("tiempo_activo_seg")
  tiempoOciosoSeg     Int                       @default(0) @map("tiempo_ocioso_seg")
  tiempoFueraSeg      Int                       @default(0) @map("tiempo_fuera_seg")
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")

  usuario             Usuario                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizacion        Organizacion              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  questionnaire       Questionnaire?            @relation(fields: [questionnaireId], references: [id], onDelete: SetNull)
  eventosConducta     BehaviorEvent[]
  respuestasControl   ControlQuestionResponse[]
  incidentes          Incident[]

  @@map("supervision_sessions")
}

model BehaviorEvent {
  id         String             @id @default(uuid())
  sessionId  String             @map("session_id")
  userId     String             @map("user_id")
  tipo       String             @map("tipo")
  severidad  String             @default("LOW") @map("severidad")
  duracionMs Int?               @map("duracion_ms")
  detalles   Json?              @map("detalles")
  timestamp  DateTime           @default(now()) @map("timestamp")

  session    SupervisionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, tipo])
  @@map("behavior_events")
}

model ControlQuestion {
  id              String                    @id @default(uuid())
  questionnaireId String?                   @map("questionnaire_id")
  pregunta        String                    @map("pregunta")
  categoria       String                    @default("INTEGRIDAD") @map("categoria")
  orden           Int                       @default(1) @map("orden")
  tiempoEsperaSeg Int                       @default(5) @map("tiempo_espera_seg")
  createdAt       DateTime                  @default(now()) @map("created_at")

  questionnaire   Questionnaire?            @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  respuestas      ControlQuestionResponse[]

  @@map("control_questions")
}

model ControlQuestionResponse {
  id                  String             @id @default(uuid())
  sessionId           String             @map("session_id")
  preguntaId          String             @map("pregunta_id")
  evaluadorId         String?            @map("evaluador_id")
  disparadaEn         DateTime           @default(now()) @map("disparada_en")
  latenciaRespuestaMs Int?               @map("latencia_respuesta_ms")
  deltaTensionFacial  Float?             @map("delta_tension_facial")
  detallesBiometricos Json?              @map("detalles_biometricos")
  notasEvaluador      String?            @map("notas_evaluador")

  session             SupervisionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  pregunta            ControlQuestion    @relation(fields: [preguntaId], references: [id], onDelete: Cascade)

  @@map("control_question_responses")
}

// Sprint 4: Incidentes Correlacionados por Reglas Declarativas
model Incident {
  id            String             @id @default(uuid())
  sessionId     String             @map("session_id")
  tipo          String             @map("tipo")
  severidad     String             @default("MEDIUM") @map("severidad") // LOW | MEDIUM | HIGH | CRITICAL
  estado        String             @default("PENDIENTE") @map("estado") // PENDIENTE | CONFIRMADO | DESESTIMADO | FALSO_POSITIVO
  resumen       String             @map("resumen")
  signals       Json               @map("signals")
  timestamp     DateTime           @default(now()) @map("timestamp")
  auditorId     String?            @map("auditor_id")
  auditadoEn    DateTime?          @map("auditado_en")
  justificacion String?            @map("justificacion")

  session       SupervisionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, estado])
  @@map("incidents")
}
